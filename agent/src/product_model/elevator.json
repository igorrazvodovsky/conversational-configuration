      "type": "implication",
      "if_all": [{ "var": "accessibility", "in": ["en81_70", "ada"] }],
      "then": { "var": "mirror", "in": ["half", "full"] }
    },
    {
      "id": "R22",
      "label": "ADA requires tactile controls (no touchscreen-only panel)",
      "type": "implication",
      "if_all": [{ "var": "accessibility", "in": ["ada"] }],
      "then": { "var": "cop", "in": ["standard", "vandal"] }
    },
    {
      "id": "R23",
      "label": "Glass landing doors are not available fire-rated",
      "type": "implication",
      "if_all": [{ "var": "door_finish", "in": ["glass"] }],
      "then": { "var": "fire_rating", "in": ["none"] }
    },
    {
      "id": "R24",
      "label": "Tall public buildings require fire-rated landing doors",
      "type": "implication",
      "if_all": [
        { "var": "building_type", "in": ["office", "hotel", "hospital"] },
        { "var": "travel", "in": ["high_30_50", "very_high_50_75", "tower_75_100"] }
      ],
      "then": { "var": "fire_rating", "in": ["e120", "ei60"] }
    },
    {
      "id": "R25",
      "label": "Panoramic glass wall exceeds weight budget at 2500 kg",
      "type": "implication",
      "if_all": [{ "var": "wall_finish", "in": ["glass_panoramic"] }],
      "then": { "var": "rated_load", "in": ["kg630", "kg800", "kg1000", "kg1250", "kg1600", "kg2000"] }
    },
    {
      "id": "R26",
      "label": "Granite floor exceeds weight budget on the smallest car",
      "type": "implication",
      "if_all": [{ "var": "floor", "in": ["granite"] }],
      "then": { "var": "rated_load", "in": ["kg800", "kg1000", "kg1250", "kg1600", "kg2000", "kg2500"] }
    },
    {
      "id": "R27",
      "label": "Modernization cannot deepen the existing pit to 2100 mm",
      "type": "implication",
      "if_all": [{ "var": "installation", "in": ["modernization"] }],
      "then": { "var": "pit_depth", "in": ["p1100", "p1400", "p1600"] }
    },
    {
      "id": "R28",
      "label": "Modernization cannot raise the existing headroom to 4600 mm",
      "type": "implication",
      "if_all": [{ "var": "installation", "in": ["modernization"] }],
      "then": { "var": "headroom", "in": ["h3400", "h3800", "h4200"] }
    },
    {
      "id": "R29",
      "label": "Retail traffic requires a vandal-resistant panel",
      "type": "implication",
      "if_all": [{ "var": "building_type", "in": ["retail"] }],
      "then": { "var": "cop", "in": ["vandal"] }
    },
    {
      "id": "R30",
      "label": "4-panel center doors need the wider shaft tiers",
      "type": "implication",
      "if_all": [{ "var": "door_type", "in": ["center_4"] }],
      "then": { "var": "shaft", "in": ["t4_2500x2200", "t5_2700x2900", "t6_3000x3000"] }
    },
    {
      "id": "R31",
      "label": "The 99.9 % uptime promise requires remote monitoring",
      "type": "implication",
      "if_all": [{ "var": "service_level", "in": ["premium"] }],
      "then": { "var": "connectivity_package", "in": ["connected"] }
    },
    {
      "id": "R32",
      "label": "Near-continuous traffic exceeds the hydraulic drive's duty cycle",
      "type": "implication",
      "if_all": [{ "var": "usage_profile", "in": ["heavy"] }],
      "then": { "var": "drive", "in": ["gearless_mrl", "gearless_mr"] }
    },
    {
      "id": "R33",
      "label": "Building type bounds the plausible usage profile",
      "type": "table",
      "vars": ["building_type", "usage_profile"],
      "allowed": [
        ["residential", "low"], ["residential", "medium"],
        ["hotel", "medium"],
        ["office", "medium"], ["office", "heavy"],
        ["retail", "medium"], ["retail", "heavy"],
        ["hospital", "heavy"]
      ]
    },
    {
      "id": "R34",
      "label": "Hospitals require at least the standard service level",
      "type": "implication",
      "if_all": [{ "var": "building_type", "in": ["hospital"] }],
      "then": { "var": "service_level", "in": ["standard", "premium"] }
    }
  ]
}
